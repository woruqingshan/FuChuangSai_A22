www.zhixinbanxing.com {
	redir https://zhixinbanxing.com{uri} permanent
}

zhixinbanxing.com {
	encode zstd gzip

	handle /healthz {
		respond "ok\n" 200
	}

	handle /api/status {
		uri strip_prefix /api
		reverse_proxy 127.0.0.1:18080
	}

	handle /api/chat {
		uri strip_prefix /api
		reverse_proxy 127.0.0.1:18080
	}

	handle /api/* {
		header Content-Type application/json
		respond `{"detail":"AI service gateway is not connected yet"}` 503
	}

	handle /media/video-stream/* {
		reverse_proxy 127.0.0.1:18080
	}

	handle /media/video-chunk/* {
		reverse_proxy 127.0.0.1:18080
	}

	handle /media/video/* {
		reverse_proxy 127.0.0.1:18080
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
